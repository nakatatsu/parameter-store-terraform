{
  "name": "parameter-store-terraform",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "psm",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=parameter-store-terraform-aws,target=/home/psm/.aws,type=volume",
    "source=parameter-store-terraform-sops-age,target=/home/psm/.config/sops/age,type=volume"
  ],
  "containerEnv": {
    "AWS_REGION": "ap-northeast-1",
    "SOPS_AGE_KEY_FILE": "/home/psm/.config/sops/age/keys.txt"
  },
  "postCreateCommand": "git config --global --add safe.directory /workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform"
      ]
    }
  }
}
